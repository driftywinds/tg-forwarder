# FileStore Bot — environment variables
# Copy this to .env and fill in your values.

# Your bot token from @BotFather
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# Comma-separated Telegram user IDs who are admins
# Get your ID by messaging @userinfobot
ADMIN_IDS=123456789,987654321

# Path to the SQLite database file (created automatically)
DB_PATH=filestore.db

# How many files to show per page in /listfiles (default: 8)
PAGE_SIZE=8

# Optional: SOCKS5 proxy URL for routing through a proxy
# Supports these formats:
#   socks5://host:port
#   socks5://user:pass@host:port
#   https://t.me/socks?server=host&port=port
# PROXY_URL=socks5://127.0.0.1:1080
